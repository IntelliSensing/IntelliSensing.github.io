---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items?: CollectionEntry<'blogs'>[];
}

const { items = [] } = Astro.props;
---

<section class="latest-blogs" id="blogs" aria-labelledby="latest-blogs-title">
  <div class="latest-blogs-inner">
    <header class="latest-blogs-header">
      <div class="latest-blogs-header-top">
        <h2 id="latest-blogs-title" data-en="Latest Blogs" data-zh="最新博客">Latest Blogs</h2>
        <a class="latest-blogs-all" href="/blogs/">
          <span data-en="View blogs" data-zh="查看全部博客">View blogs</span>
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="16" cy="16" r="16"></circle>
            <path d="M8 16.956h12.604l-3.844 4.106 1.252 1.338L24 16l-5.988-6.4-1.252 1.338 3.844 4.106H8v1.912z"></path>
          </svg>
        </a>
      </div>
      <p
        data-en="Research notes, technical reflections, and ideas taking shape inside IntelliSensing Lab."
        data-zh="记录 IntelliSensing Lab 的研究札记、技术思考与正在形成中的想法。"
      >Research notes, technical reflections, and ideas taking shape inside IntelliSensing Lab.</p>
    </header>

    <div class="latest-blogs-grid">
      {items.map((item) => (
        <article class="latest-blog-card">
          <a href={`/blogs/${item.id}/`} aria-label={`Read ${item.data.title}`}>
            <span class="latest-blog-media">
              <img src={item.data.image} alt="" loading="lazy" decoding="async" />
            </span>
            <span class="latest-blog-content">
              <span class="latest-blog-category">{item.data.category}</span>
              <strong>{item.data.title}</strong>
              <span class="latest-blog-description">{item.data.description}</span>
            </span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .latest-blogs {
    padding: var(--home-section-gap) 0;
    color: #111;
    background: #fff;
  }

  .latest-blogs-inner {
    width: min(calc(100% - 96px), 1260px);
    margin-inline: auto;
  }

  .latest-blogs-header {
    margin-bottom: 40px;
  }

  .latest-blogs-header-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 48px;
  }

  .latest-blogs-header h2 {
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .latest-blogs-header p {
    max-width: 670px;
    margin: 20px 0 0;
    color: #5b5b5b;
    font-size: 17px;
    line-height: 1.55;
  }

  .latest-blogs-all {
    display: inline-grid;
    grid-template-columns: max-content 28px;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    color: #111;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 17px;
    font-weight: 760;
  }

  .latest-blogs-all svg {
    display: block;
    width: 28px;
    height: 28px;
    transition: transform 180ms ease;
  }

  .latest-blogs-all circle {
    fill: #e53935;
  }

  .latest-blogs-all path {
    fill: #fff;
  }

  .latest-blogs-all:hover svg {
    transform: translateX(3px);
  }

  .latest-blogs-all:focus-visible {
    outline: 2px solid #e53935;
    outline-offset: 5px;
  }

  .latest-blogs-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .latest-blog-card {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(17, 24, 39, 0.07);
    transition: box-shadow 220ms ease, transform 220ms ease;
  }

  .latest-blog-card:hover {
    box-shadow: 0 16px 36px rgba(17, 24, 39, 0.1);
    transform: translateY(-3px);
  }

  .latest-blog-card > a {
    display: flex;
    min-height: 520px;
    flex-direction: column;
    color: #111;
  }

  .latest-blog-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid rgba(17, 24, 39, 0.08);
    background: #edf0f2;
  }

  .latest-blog-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
  }

  .latest-blog-card:hover .latest-blog-media img {
    transform: scale(1.025);
  }

  .latest-blog-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px 26px 22px;
  }

  .latest-blog-category {
    color: #d33a35;
    font-size: 14px;
    font-weight: 760;
    line-height: 1.3;
  }

  .latest-blog-content strong {
    display: block;
    margin-top: 24px;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 25px;
    font-weight: 760;
    line-height: 1.28;
    letter-spacing: 0;
  }

  .latest-blog-description {
    display: -webkit-box;
    margin-top: 18px;
    overflow: hidden;
    color: #5b5f64;
    font-size: 16px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 980px) {
    .latest-blogs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .latest-blogs {
      padding: var(--home-section-gap) 0;
    }

    .latest-blogs-inner {
      width: calc(100% - 40px);
    }

    .latest-blogs-header-top {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .latest-blogs-header {
      margin-bottom: 30px;
    }

    .latest-blogs-header h2 {
      font-size: 36px;
    }

    .latest-blogs-header p {
      font-size: 16px;
    }

    .latest-blogs-all {
      justify-self: start;
      margin-top: 0;
    }

    .latest-blogs-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin-inline: auto;
      gap: 20px;
    }

    .latest-blog-card > a {
      min-height: 500px;
    }

    .latest-blog-content {
      padding: 24px 22px 20px;
    }

    .latest-blog-content strong {
      font-size: 23px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-blog-card,
    .latest-blog-media img,
    .latest-blogs-all svg {
      transition: none;
    }
  }
</style>
