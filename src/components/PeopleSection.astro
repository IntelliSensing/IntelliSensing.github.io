            <h3 data-en="Students & research assistants" data-zh="学生与科研助理">Students & research assistants</h3>
          </div>
          <a class="people-panel-link" href="/our-team/">
            <span data-en="View all members" data-zh="查看全部成员">View all members</span>
            <span aria-hidden="true">→</span>
          </a>
        </header>

        <div class="people-stats" aria-label="Team composition">
          {teamStats.map((stat) => (
            <div class="people-stat">
              <strong>{stat.value}</strong>
              <span data-en={stat.label} data-zh={stat.labelZh}>{stat.label}</span>
            </div>
          ))}
        </div>

        <div class="people-carousel-shell" data-people-carousel>
          <button class="people-carousel-button" type="button" data-carousel-previous aria-label="Previous members" title="Previous members">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <div class="people-member-carousel" data-carousel-track tabindex="0">
            {students.map((member) => (
              <a class="people-member" href={`/our-team/${member.slug}/`}>
                <img src={member.img} alt="" loading="lazy" decoding="async" />
                <span class="people-member-name">{member.name}</span>
                <span class="people-member-role" data-en={member.role} data-zh={member.roleZh}>{member.role}</span>
              </a>
            ))}
          </div>
          <button class="people-carousel-button" type="button" data-carousel-next aria-label="Next members" title="Next members">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
