---
import { team } from '../data/team';

const students = team.filter((member) => member.slug !== 'wenjia-xu');

const piStats = [
  {
    value: '1,370+',
    label: 'Total citations',
    labelZh: '论文总被引',
  },
  {
    value: 'h-index 18',
    label: 'Google Scholar',
    labelZh: 'Google Scholar',
  },
  {
    value: '40+',
    label: 'Publications',
    labelZh: '已发表论文',
  },
];

const teamStats = [
  {
    value: students.length,
    label: 'Members',
    labelZh: '团队成员',
  },
  {
    value: students.filter((member) => member.role === 'PhD Student').length,
    label: 'PhD Students',
    labelZh: '博士生',
  },
  {
    value: students.filter((member) => member.role === 'Master Student').length,
    label: 'Master Students',
    labelZh: '硕士生',
  },
  {
    value: students.filter((member) => member.role === 'Research Assistant').length,
    label: 'Research Assistants',
    labelZh: '科研助理',
  },
];
---

<section class="people-header-section" aria-labelledby="people-title">
  <div class="people-header-inner">
    <header class="people-header">
      <h2
        id="people-title"
        data-en="People behind these scientific questions"
        data-zh="这些科学问题背后的研究者"
      >People behind these scientific questions</h2>
      <a class="people-link" href="/our-team/">
        <span class="people-link-label" data-en="View Team" data-zh="认识团队">View Team</span>
        <svg class="people-link-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle class="button-primary-circle" cx="16" cy="16" r="16"></circle>
          <path d="M8 16.956h12.604l-3.844 4.106 1.252 1.338L24 16l-5.988-6.4-1.252 1.338 3.844 4.106H8v1.912z" class="color-spacesuit-white"></path>
        </svg>
      </a>
    </header>
    <p
      class="people-subtitle"
      data-en="We are driven by creativity and curiosity to push back the frontiers of knowledge"
      data-zh="我们以创造力和好奇心为动力，不断拓展知识的边界"
    >We are driven by creativity and curiosity to push back the frontiers of knowledge</p>
  </div>
</section>

