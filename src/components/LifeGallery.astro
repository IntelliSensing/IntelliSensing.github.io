---
import { getCollection } from 'astro:content';

/**
 * A single auto-scrolling strip of photos on the homepage. Entries in the
 * `life` collection are albums, but the strip shows one slide per photo so a
 * dinner with eight shots reads as eight moments rather than one card.
 *
 * Slides keep their natural aspect ratio inside a fixed-height track, so a wide
 * group shot and a portrait snapshot can sit side by side without cropping.
 */
const photos = (await getCollection('life'))
  .filter((entry) => !entry.data.draft && entry.data.images.length > 0)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .flatMap((entry) => entry.data.images.map((image) => ({
    image,
    titleEn: entry.data.titleEn ?? entry.data.title,
    titleZh: entry.data.titleZh ?? entry.data.title,
    categoryEn: entry.data.categoryEn ?? entry.data.category,
    categoryZh: entry.data.categoryZh ?? entry.data.category,
    dateEn: entry.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }),
    dateZh: entry.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' }),
  })));

// The strip loops by scrolling through one half of a doubled list and resetting
// at the midpoint. Each half has to out-width the viewport or the loop shows a
// gap, so a short collection is repeated until there is enough to fill it.
const repeats = photos.length > 0 ? Math.max(1, Math.ceil(8 / photos.length)) : 0;
const half = Array.from({ length: repeats }, () => photos).flat();
const track = [...half, ...half];
---

<section class="life-strip" id="life" aria-labelledby="life-strip-title">
  <div class="life-strip-header">
    <h2 id="life-strip-title" data-en="Life beyond research" data-zh="科研之外的生活与娱乐">Life beyond research</h2>
    <p
      data-en="Dinners, outings and the conferences we travelled to together — the part of lab life that does not show up in a paper."
      data-zh="聚餐、出游，还有一起参加的学术会议——论文之外的实验室日常。"
    >Dinners, outings and the conferences we travelled to together — the part of lab life that does not show up in a paper.</p>
  </div>

  {photos.length > 0 ? (
    <div class="life-strip-viewport" data-life-strip>
      <div class="life-strip-track" data-life-track>
        {track.map((photo, index) => (
          <figure class="life-slide" aria-hidden={index >= half.length ? 'true' : undefined}>
            <img src={photo.image} alt={photo.titleEn} loading="lazy" decoding="async" draggable="false" />
            <figcaption class="life-slide-caption">
              <span class="life-slide-category" data-en={photo.categoryEn} data-zh={photo.categoryZh}>{photo.categoryEn}</span>
              <span data-en={photo.titleEn} data-zh={photo.titleZh}>{photo.titleEn}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  ) : (
    <p
      class="life-strip-empty"
      data-en="Photos are being collected — this strip will fill up soon."
      data-zh="照片还在收集中，这里很快就会热闹起来。"
    >Photos are being collected — this strip will fill up soon.</p>
  )}
</section>

<script>
  const initializeLifeStrip = () => {
    document.querySelectorAll<HTMLElement>('[data-life-strip]').forEach((viewport) => {
      const track = viewport.querySelector<HTMLElement>('[data-life-track]');
      if (!track || viewport.dataset.ready === 'true') return;
      viewport.dataset.ready = 'true';

      // The track holds two copies of the photo list, so resetting the offset
      // at the halfway mark makes the scroll loop without a visible seam.
      let offset = 0;
      let previous = 0;
      const speed = 48; // px per second

      const step = (time: number) => {
        const elapsed = previous ? Math.min(time - previous, 48) : 0;
        previous = time;

        if (!document.hidden) {
          const half = track.scrollWidth / 2;
          if (half > 0) {
            offset = (offset + elapsed * (speed / 1000)) % half;
            track.style.transform = `translate3d(${-offset}px, 0, 0)`;
          }
        }
        window.requestAnimationFrame(step);
      };

      window.requestAnimationFrame(step);
    });
  };

  initializeLifeStrip();
  document.addEventListener('astro:page-load', initializeLifeStrip);
</script>

<style>
  .life-strip {
    /* Last section on the page, so it carries the closing gap before the
       footer the way .home-page .section:last-child does elsewhere. */
    padding: var(--home-section-gap) 0 var(--home-section-gap);
    overflow: hidden;
    color: #111;
    background: #fff;
  }

  .life-strip-header {
    width: min(calc(100% - 96px), 1260px);
    margin: 0 auto 38px;
  }

  .life-strip-header h2 {
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .life-strip-header p {
    max-width: 670px;
    margin: 20px 0 0;
    color: #5b5b5b;
    font-size: 17px;
    line-height: 1.55;
  }

  .life-strip-viewport {
    width: 100%;
    overflow: hidden;
    /* Fade the strip into the page margins instead of cutting it off hard. */
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .life-strip-track {
    display: flex;
    width: max-content;
    gap: 14px;
    will-change: transform;
  }

  .life-slide {
    position: relative;
    display: block;
    height: 220px;
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    border-radius: 14px;
    background: #f1f3f4;
  }

  .life-slide img {
    display: block;
    width: auto;
    height: 100%;
    /* Display only: the strip is not a gallery you can open. */
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 520ms cubic-bezier(.16, .84, .24, 1);
  }

  .life-slide:hover img {
    transform: scale(1.03);
  }

  .life-slide-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 3px;
    padding: 26px 13px 11px;
    color: #fff;
    text-align: left;
    background: linear-gradient(180deg, transparent, rgba(8, 12, 18, 0.78));
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .life-slide:hover .life-slide-caption {
    opacity: 1;
  }

  .life-slide-category {
    color: #ffb4b2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .life-slide-caption > span:last-child {
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
  }

  .life-strip-empty {
    width: min(calc(100% - 96px), 1260px);
    margin: 0 auto;
    padding: 34px 0;
    border-top: 1px solid #e4e7ea;
    border-bottom: 1px solid #e4e7ea;
    color: #747a80;
    font-size: 15px;
  }

  @media (prefers-reduced-motion: reduce) {
    .life-strip-viewport {
      overflow-x: auto;
    }

    .life-strip-track {
      transform: none !important;
    }
  }

  @media (max-width: 1120px) {
    .life-strip-header,
    .life-strip-empty {
      width: min(calc(100% - 48px), 940px);
    }

    .life-strip-header h2 {
      font-size: 40px;
    }

    .life-slide {
      height: 190px;
    }
  }

  @media (max-width: 700px) {
    .life-strip-header,
    .life-strip-empty {
      width: calc(100% - 40px);
    }

    .life-strip-header h2 {
      font-size: 32px;
    }

    .life-slide {
      height: 150px;
    }
  }
</style>
