---
import { getCollection } from 'astro:content';

interface Props {
  /** Homepage shows a trimmed grid; the /life/ archive passes 0 for "all". */
  limit?: number;
  showHeader?: boolean;
}

const { limit = 0, showHeader = true } = Astro.props;

const albums = (await getCollection('life'))
  .filter((entry) => !entry.data.draft && entry.data.images.length > 0)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    id: entry.id,
    titleEn: entry.data.titleEn ?? entry.data.title,
    titleZh: entry.data.titleZh ?? entry.data.title,
    descriptionEn: entry.data.descriptionEn ?? entry.data.description,
    descriptionZh: entry.data.descriptionZh ?? entry.data.description,
    categoryEn: entry.data.categoryEn ?? entry.data.category,
    categoryZh: entry.data.categoryZh ?? entry.data.category,
    locationEn: entry.data.location ?? '',
    locationZh: entry.data.locationZh ?? entry.data.location ?? '',
    images: entry.data.images,
    dateEn: entry.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    dateZh: entry.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }),
  }));

const visibleAlbums = limit > 0 ? albums.slice(0, limit) : albums;
const hasMore = limit > 0 && albums.length > limit;
---

<section class="life-gallery" id="life" aria-labelledby="life-gallery-title">
  <div class="life-gallery-inner">
    {showHeader && (
      <header class="life-gallery-header">
        <div class="life-gallery-header-top">
          <h2
            id="life-gallery-title"
            data-en="Life beyond research"
            data-zh="科研之外的生活与娱乐"
          >Life beyond research</h2>
          <a class="life-gallery-all" href="/life/">
            <span data-en="View all photos" data-zh="查看全部照片">View all photos</span>
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="16" cy="16" r="16"></circle>
              <path d="M8 16.956h12.604l-3.844 4.106 1.252 1.338L24 16l-5.988-6.4-1.252 1.338 3.844 4.106H8v1.912z"></path>
            </svg>
          </a>
        </div>
        <p
          data-en="Dinners, outings and the conferences we travelled to together — the part of lab life that does not show up in a paper."
          data-zh="聚餐、出游，还有一起参加的学术会议——论文之外的实验室日常。"
        >Dinners, outings and the conferences we travelled to together — the part of lab life that does not show up in a paper.</p>
      </header>
    )}

    {visibleAlbums.length > 0 ? (
      <div class="life-grid">
        {visibleAlbums.map((album) => (
          <button
            class="life-card"
            type="button"
            data-life-album={JSON.stringify({
              images: album.images,
              titleEn: album.titleEn,
              titleZh: album.titleZh,
              descriptionEn: album.descriptionEn,
              descriptionZh: album.descriptionZh,
            })}
            aria-label={`Open photos from ${album.titleEn}`}
          >
            <span class="life-card-media">
              <img src={album.images[0]} alt="" loading="lazy" decoding="async" />
              {album.images.length > 1 && (
                <span class="life-card-count">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="3" width="14" height="14" rx="2" /><path d="M7 21h12a2 2 0 0 0 2-2V7" />
                  </svg>
                  {album.images.length}
                </span>
              )}
            </span>
            <span class="life-card-body">
              <span class="life-card-meta">
                <span class="life-card-category" data-en={album.categoryEn} data-zh={album.categoryZh}>{album.categoryEn}</span>
                <time data-en={album.dateEn} data-zh={album.dateZh}>{album.dateEn}</time>
              </span>
              <strong data-en={album.titleEn} data-zh={album.titleZh}>{album.titleEn}</strong>
              <span class="life-card-description" data-en={album.descriptionEn} data-zh={album.descriptionZh}>{album.descriptionEn}</span>
              {album.locationEn && (
                <span class="life-card-location" data-en={album.locationEn} data-zh={album.locationZh}>{album.locationEn}</span>
              )}
            </span>
          </button>
        ))}
      </div>
    ) : (
      <p
        class="life-empty"
        data-en="Photos are being collected — this wall will fill up soon."
        data-zh="照片还在收集中，这里很快就会热闹起来。"
      >Photos are being collected — this wall will fill up soon.</p>
    )}

    {hasMore && (
      <a class="life-gallery-more" href="/life/">
        <span data-en="See more moments" data-zh="查看更多">See more moments</span>
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>

<div class="life-lightbox" id="life-lightbox" hidden>
  <button class="life-lightbox-close" type="button" data-life-close aria-label="Close">&times;</button>
  <button class="life-lightbox-arrow is-previous" type="button" data-life-previous aria-label="Previous photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg>
  </button>
  <figure class="life-lightbox-figure">
    <img id="life-lightbox-image" src="" alt="" />
    <figcaption>
      <strong id="life-lightbox-title"></strong>
      <span id="life-lightbox-description"></span>
      <span class="life-lightbox-counter" id="life-lightbox-counter"></span>
    </figcaption>
  </figure>
  <button class="life-lightbox-arrow is-next" type="button" data-life-next aria-label="Next photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" /></svg>
  </button>
</div>

<script>
  interface LifeAlbum {
    images: string[];
    titleEn: string;
    titleZh: string;
    descriptionEn: string;
    descriptionZh: string;
  }

  const initializeLifeGallery = () => {
    const lightbox = document.getElementById('life-lightbox');
    const image = document.getElementById('life-lightbox-image') as HTMLImageElement | null;
    const title = document.getElementById('life-lightbox-title');
    const description = document.getElementById('life-lightbox-description');
    const counter = document.getElementById('life-lightbox-counter');
    if (!lightbox || !image || lightbox.dataset.ready === 'true') return;
    lightbox.dataset.ready = 'true';

    let album: LifeAlbum | null = null;
    let index = 0;

    const isChinese = () => document.documentElement.lang === 'zh-CN';

    const render = () => {
      if (!album) return;
      index = (index + album.images.length) % album.images.length;
      image.src = album.images[index];
      if (title) {
        title.setAttribute('data-en', album.titleEn);
        title.setAttribute('data-zh', album.titleZh);
        title.textContent = isChinese() ? album.titleZh : album.titleEn;
      }
      if (description) {
        description.setAttribute('data-en', album.descriptionEn);
        description.setAttribute('data-zh', album.descriptionZh);
        description.textContent = isChinese() ? album.descriptionZh : album.descriptionEn;
      }
      if (counter) counter.textContent = `${index + 1} / ${album.images.length}`;
      lightbox.classList.toggle('has-single-image', album.images.length < 2);
    };

    const close = () => {
      lightbox.hidden = true;
      album = null;
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('[data-life-album]').forEach((card) => {
      card.addEventListener('click', () => {
        try {
          album = JSON.parse(card.dataset.lifeAlbum ?? '') as LifeAlbum;
        } catch {
          return;
        }
        index = 0;
        render();
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    });

    lightbox.querySelector('[data-life-close]')?.addEventListener('click', close);
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });
    lightbox.querySelector('[data-life-previous]')?.addEventListener('click', () => { index -= 1; render(); });
    lightbox.querySelector('[data-life-next]')?.addEventListener('click', () => { index += 1; render(); });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') { index -= 1; render(); }
      if (event.key === 'ArrowRight') { index += 1; render(); }
    });
  };

  initializeLifeGallery();
  document.addEventListener('astro:page-load', initializeLifeGallery);
</script>

<style>
  .life-gallery {
    padding: var(--home-section-gap) 0 0;
    color: #111;
    background: #fff;
  }

  .life-gallery-inner {
    width: min(calc(100% - 96px), 1260px);
    margin-inline: auto;
  }

  .life-gallery-header {
    margin-bottom: 40px;
  }

  .life-gallery-header-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 48px;
  }

  .life-gallery-header h2 {
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .life-gallery-header p {
    max-width: 670px;
    margin: 20px 0 0;
    color: #5b5b5b;
    font-size: 17px;
    line-height: 1.55;
  }

  .life-gallery-all {
    display: inline-grid;
    grid-template-columns: max-content 28px;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    color: #111;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 17px;
    font-weight: 760;
    text-decoration: none;
    white-space: nowrap;
  }

  .life-gallery-all svg {
    display: block;
    width: 28px;
    height: 28px;
    transition: transform 180ms ease;
  }

  .life-gallery-all circle {
    fill: #e53935;
  }

  .life-gallery-all path {
    fill: #fff;
  }

  .life-gallery-all:hover svg {
    transform: translateX(3px);
  }

  .life-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .life-card {
    display: block;
    padding: 0;
    border: 0;
    color: inherit;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .life-card-media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 18px;
    background: #f1f3f4;
  }

  .life-card-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 520ms cubic-bezier(.16, .84, .24, 1);
  }

  .life-card:hover .life-card-media img {
    transform: scale(1.06);
  }

  .life-card-count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 999px;
    color: #fff;
    background: rgba(17, 17, 17, 0.62);
    backdrop-filter: blur(6px);
    font-size: 12px;
    font-weight: 700;
  }

  .life-card-count svg {
    width: 13px;
    height: 13px;
  }

  .life-card-body {
    display: block;
    padding: 16px 2px 0;
  }

  .life-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #8a9097;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .life-card-category {
    color: #c93430;
  }

  .life-card-body strong {
    display: block;
    margin-top: 9px;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 20px;
    font-weight: 750;
    line-height: 1.25;
  }

  .life-card:hover .life-card-body strong {
    color: #c93430;
  }

  .life-card-description {
    display: block;
    margin-top: 8px;
    color: #5f656b;
    font-size: 15px;
    line-height: 1.55;
  }

  .life-card-location {
    display: block;
    margin-top: 10px;
    color: #8a9097;
    font-size: 13px;
  }

  .life-empty {
    margin: 0;
    padding: 34px 0;
    border-top: 1px solid #e4e7ea;
    border-bottom: 1px solid #e4e7ea;
    color: #747a80;
    font-size: 15px;
  }

  .life-gallery-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 34px;
    color: #111;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .life-gallery-more:hover {
    color: #c93430;
  }

  .life-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 5vh 4vw;
    background: rgba(6, 10, 16, 0.9);
    backdrop-filter: blur(6px);
  }

  .life-lightbox[hidden] {
    display: none;
  }

  .life-lightbox-figure {
    display: flex;
    max-width: min(1100px, 100%);
    max-height: 90vh;
    flex-direction: column;
    margin: 0;
    gap: 16px;
  }

  .life-lightbox-figure img {
    max-height: 74vh;
    border-radius: 12px;
    object-fit: contain;
  }

  .life-lightbox-figure figcaption {
    display: grid;
    gap: 6px;
    color: rgba(255, 255, 255, 0.82);
    text-align: center;
  }

  .life-lightbox-figure figcaption strong {
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 18px;
    font-weight: 750;
    color: #fff;
  }

  .life-lightbox-figure figcaption span {
    font-size: 14px;
    line-height: 1.5;
  }

  .life-lightbox-counter {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .life-lightbox-close {
    position: absolute;
    top: 22px;
    right: 26px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }

  .life-lightbox-arrow {
    display: grid;
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    place-items: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: background 180ms ease;
  }

  .life-lightbox-arrow:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .life-lightbox-arrow svg {
    width: 22px;
    height: 22px;
  }

  .life-lightbox.has-single-image .life-lightbox-arrow {
    visibility: hidden;
  }

  @media (max-width: 1120px) {
    .life-gallery-inner {
      width: min(calc(100% - 48px), 940px);
    }

    .life-gallery-header h2 {
      font-size: 40px;
    }

    .life-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
  }

  @media (max-width: 700px) {
    .life-gallery-inner {
      width: calc(100% - 40px);
    }

    .life-gallery-header-top {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .life-gallery-header h2 {
      font-size: 32px;
    }

    .life-grid {
      grid-template-columns: 1fr;
    }

    .life-lightbox {
      padding: 4vh 12px;
      gap: 8px;
    }

    .life-lightbox-arrow {
      width: 38px;
      height: 38px;
    }
  }
</style>
