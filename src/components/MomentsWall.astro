---
import { getCollection } from 'astro:content';

const moments = (await getCollection('markers'))
  .filter((marker) => !marker.data.draft && marker.data.images.length > 0)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((marker) => ({
    id: marker.id,
    titleEn: marker.data.titleEn ?? marker.data.title,
    titleZh: marker.data.titleZh ?? marker.data.title,
    descriptionEn: marker.data.descriptionEn ?? marker.data.description,
    descriptionZh: marker.data.descriptionZh ?? marker.data.description,
    categoryEn: marker.data.categoryEn ?? marker.data.category,
    categoryZh: marker.data.categoryZh ?? marker.data.category,
    image: marker.data.images[0],
    dateEn: marker.data.date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).toUpperCase(),
    dateZh: marker.data.date.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }),
  }));
---

<section class="moments-wall" aria-labelledby="moments-wall-title">
  <div class="moments-wall-header">
    <div class="moments-wall-header-top">
      <h2
        id="moments-wall-title"
        data-en="Moments across Earth"
        data-zh="地球上的研究足迹"
      >Moments across Earth</h2>
      <button class="moments-wall-link" type="button" data-view-moments>
        <span data-en="View moments" data-zh="查看全部足迹">View moments</span>
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="16" cy="16" r="16"></circle>
          <path d="M8 16.956h12.604l-3.844 4.106 1.252 1.338L24 16l-5.988-6.4-1.252 1.338 3.844 4.106H8v1.912z"></path>
        </svg>
      </button>
    </div>
    <p
      data-en="Fieldwork, conferences and the moments that connect our team across the world."
      data-zh="记录团队在世界各地的学术会议、实地工作与共同经历。"
    >Fieldwork, conferences and the moments that connect our team across the world.</p>
  </div>

  <div class="moments-wall-viewport" data-moments-wall>
    <div class="moments-wall-track">
      {moments.map((moment) => (
        <button
          class="moment-card"
          type="button"
          data-marker-id={moment.id}
          aria-label={`Open ${moment.titleEn} in Earth Explorer`}
        >
          <img src={moment.image} alt="" loading="lazy" decoding="async" />
          <span class="moment-card-overlay">
            <span class="moment-card-meta">
              <span data-en={moment.categoryEn} data-zh={moment.categoryZh}>{moment.categoryEn}</span>
              <time data-en={moment.dateEn} data-zh={moment.dateZh}>{moment.dateEn}</time>
            </span>
            <strong data-en={moment.titleEn} data-zh={moment.titleZh}>{moment.titleEn}</strong>
            <span
              class="moment-card-description"
              data-en={moment.descriptionEn}
              data-zh={moment.descriptionZh}
            >{moment.descriptionEn}</span>
            <span class="moment-card-action">
              <span data-en="View on Earth" data-zh="在地球上查看">View on Earth</span>
              <span aria-hidden="true">→</span>
            </span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const initializeMomentsWalls = () => {
    document.querySelectorAll<HTMLElement>('[data-moments-wall]').forEach((viewport) => {
      if (viewport.dataset.ready === 'true') return;
      viewport.dataset.ready = 'true';

      let direction = 1;
      let paused = false;
      let previousTime = 0;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const updatePosition = (time: number) => {
        const elapsed = previousTime ? Math.min(time - previousTime, 40) : 0;
        previousTime = time;

        if (!paused && !document.hidden && !reducedMotion.matches) {
          const maximum = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
          viewport.scrollLeft += direction * elapsed * 0.035;

          if (direction > 0 && viewport.scrollLeft >= maximum - 0.5) {
            viewport.scrollLeft = maximum;
            direction = -1;
          } else if (direction < 0 && viewport.scrollLeft <= 0.5) {
            viewport.scrollLeft = 0;
            direction = 1;
          }
        }

        window.requestAnimationFrame(updatePosition);
      };

      viewport.addEventListener('focusin', () => { paused = true; });
      viewport.addEventListener('focusout', (event) => {
        if (!viewport.contains(event.relatedTarget as Node | null)) paused = false;
      });

      viewport.querySelectorAll<HTMLButtonElement>('[data-marker-id]').forEach((card) => {
        card.addEventListener('click', () => {
          const id = card.dataset.markerId;
          if (!id) return;
          window.dispatchEvent(new CustomEvent('earth-explorer:open-marker', {
            detail: { id },
          }));
        });
      });

      window.requestAnimationFrame(updatePosition);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-view-moments]').forEach((button) => {
      if (button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('earth-explorer:view-moments'));
      });
    });
  };

  initializeMomentsWalls();
  document.addEventListener('astro:page-load', initializeMomentsWalls);
</script>

<style>
  .moments-wall {
    overflow: hidden;
    padding: var(--home-section-gap) 0 0;
    color: #111;
    background: #fff;
  }

  .moments-wall-header {
    width: min(calc(100% - 96px), 1260px);
    margin: 0 auto 40px;
  }

  .moments-wall-header-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 48px;
  }

  .moments-wall-header h2 {
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .moments-wall-header p {
    max-width: 670px;
    margin: 20px 0 0;
    color: #5b5b5b;
    font-size: 17px;
    line-height: 1.55;
  }

  .moments-wall-link {
    display: inline-grid;
    grid-template-columns: max-content 28px;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    padding: 0;
    border: 0;
    color: #111;
    background: transparent;
    font: inherit;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 17px;
    font-weight: 760;
    cursor: pointer;
  }

  .moments-wall-link svg {
    display: block;
    width: 28px;
    height: 28px;
    transition: transform 180ms ease;
  }

  .moments-wall-link circle {
    fill: #e53935;
  }

  .moments-wall-link path {
    fill: #fff;
  }

  .moments-wall-link:hover svg {
    transform: translateX(3px);
  }

  .moments-wall-link:focus-visible {
    outline: 2px solid #e53935;
    outline-offset: 5px;
  }

  .moments-wall-viewport {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  .moments-wall-viewport::-webkit-scrollbar {
    display: none;
  }

  .moments-wall-track {
    display: flex;
    width: max-content;
    gap: 14px;
    padding: 12px max(48px, calc((100vw - 1260px) / 2));
  }

  .moment-card {
    position: relative;
    width: clamp(300px, 31vw, 460px);
    aspect-ratio: 16 / 10;
    flex: 0 0 auto;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: 8px;
    color: #fff;
    background: #e8eaec;
    cursor: pointer;
    text-align: left;
  }

  .moment-card > img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease, filter 320ms ease;
  }

  .moment-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    padding: 26px;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(180deg, rgba(4, 8, 14, 0.04) 14%, rgba(4, 8, 14, 0.9) 100%);
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .moment-card:hover > img,
  .moment-card:focus-visible > img {
    filter: saturate(0.88) brightness(0.72);
    transform: scale(1.025);
  }

  .moment-card:hover .moment-card-overlay,
  .moment-card:focus-visible .moment-card-overlay {
    opacity: 1;
  }

  .moment-card:focus-visible {
    outline: 3px solid #e53935;
    outline-offset: 3px;
  }

  .moment-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .moment-card-overlay strong {
    margin-top: 12px;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 24px;
    line-height: 1.2;
  }

  .moment-card-description {
    display: -webkit-box;
    margin-top: 10px;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .moment-card-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .moments-wall {
      padding: var(--home-section-gap) 0 0;
    }

    .moments-wall-header {
      width: calc(100% - 40px);
      margin-bottom: 28px;
    }

    .moments-wall-header h2 {
      font-size: 34px;
    }

    .moments-wall-header-top {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .moments-wall-link {
      justify-self: start;
      margin-top: 0;
      font-size: 16px;
    }

    .moments-wall-header p {
      font-size: 15px;
    }

    .moments-wall-track {
      gap: 12px;
      padding-inline: 20px;
    }

    .moment-card {
      width: min(82vw, 360px);
    }

    .moment-card-overlay {
      padding: 20px;
    }

    .moment-card-overlay strong {
      font-size: 20px;
    }
  }

  @media (hover: none) {
    .moment-card-overlay {
      inset: auto 0 0;
      min-height: 58%;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moment-card > img,
    .moment-card-overlay {
      transition: none;
    }
  }
</style>
