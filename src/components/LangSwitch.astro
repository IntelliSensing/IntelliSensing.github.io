---
---
<div class="lang-switch" id="langSwitch" data-active="en">
  <button class="language-trigger" id="language-trigger" type="button" aria-expanded="false" aria-controls="language-options">
    <span data-en="Language" data-zh="语言">Language</span>
    <span class="language-chevron" aria-hidden="true">⌄</span>
  </button>
  <div class="language-options" id="language-options" role="menu" hidden>
    <button class="lang-option active" type="button" role="menuitemradio" aria-checked="true" data-lang="en">English</button>
    <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang="zh">中文</button>
  </div>
</div>

<style>
  .lang-switch {
    display: block;
    justify-self: end;
    position: relative;
    user-select: none;
  }

  .language-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 24px 0;
    border: 0;
    color: #161616;
    background: transparent;
    font: inherit;
    font-size: 16px;
    font-weight: 720;
    letter-spacing: 0;
    cursor: pointer;
  }

  .language-chevron {
    font-size: 16px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .language-trigger[aria-expanded="true"] .language-chevron {
    transform: rotate(180deg);
  }

  .language-options {
    position: absolute;
    top: calc(100% + 2px);
    right: 0;
    display: grid;
    width: 164px;
    padding: 6px;
    border: 1px solid #dfe2e5;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 16px 42px rgba(20, 24, 28, 0.16);
  }

  .language-options[hidden] {
    display: none;
  }

  .lang-option {
    min-height: 42px;
    padding: 0 12px;
    border: 0;
    border-radius: 3px;
    color: #555b61;
    background: transparent;
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    letter-spacing: 0;
    text-align: left;
    cursor: pointer;
  }

  .lang-option:hover {
    color: #111;
    background: #f1f3f4;
  }

  .lang-option.active {
    color: #b52d29;
    background: rgba(229, 57, 53, 0.1);
  }

  @media (max-width: 560px) {
    .language-trigger {
      padding: 22px 0;
      font-size: 13px;
    }
  }
</style>

<script>
  const languageTrigger = document.getElementById('language-trigger');
  const languageOptions = document.getElementById('language-options');

  const closeLanguageMenu = () => {
    if (!languageTrigger || !languageOptions) return;
    languageOptions.hidden = true;
    languageTrigger.setAttribute('aria-expanded', 'false');
  };

  languageTrigger?.addEventListener('click', () => {
    if (!languageOptions) return;
    const willOpen = languageOptions.hidden;
    languageOptions.hidden = !willOpen;
    languageTrigger.setAttribute('aria-expanded', String(willOpen));
  });

  languageOptions?.querySelectorAll('.lang-option').forEach((option) => {
    option.addEventListener('click', closeLanguageMenu);
  });

  document.addEventListener('click', (event) => {
    if (!languageTrigger?.parentElement?.contains(event.target as Node)) closeLanguageMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && languageOptions && !languageOptions.hidden) {
      closeLanguageMenu();
      languageTrigger?.focus();
    }
  });
</script>
