---
import { getPublicationPrimaryHref, getPublicationImage } from '../utils/publications';
import { getContentPrimaryHref } from '../utils/contentLinks';

const { item, kind } = Astro.props;

const href = kind === 'publication'
  ? getPublicationPrimaryHref(item)
  : getContentPrimaryHref(item, 'news');
const titleEn = kind === 'news' ? item.data.titleEn ?? item.data.title : item.data.title;
const titleZh = kind === 'news' ? item.data.titleZh ?? item.data.title : item.data.title;
const descriptionEn = kind === 'news' ? item.data.descriptionEn ?? item.data.description : item.data.description;
const descriptionZh = kind === 'news' ? item.data.descriptionZh ?? item.data.description : item.data.description;
const eyebrowEn = kind === 'publication' ? 'Publication' : 'News';
const eyebrowZh = kind === 'publication' ? '论文' : '新闻';
const meta = kind === 'publication'
  ? item.data.venue
  : item.data.tags[0] ?? 'Lab update';
const dateEn = item.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const dateZh = item.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="research-feed-card">
  <a href={href}>
    <span class="research-feed-media">
      <img src={getPublicationImage(item)} alt="" loading="lazy" decoding="async" />
    </span>
    <span class="research-feed-content">
      <span class="research-feed-eyebrow" data-en={eyebrowEn} data-zh={eyebrowZh}>{eyebrowEn}</span>
      <strong data-en={titleEn} data-zh={titleZh}>{titleEn}</strong>
      <span class="research-feed-description" data-en={descriptionEn} data-zh={descriptionZh}>{descriptionEn}</span>
      <span class="research-feed-footer">
        <span>{meta}</span>
        <time datetime={item.data.pubDate.toISOString()} data-en={dateEn} data-zh={dateZh}>{dateEn}</time>
      </span>
    </span>
  </a>
</article>

<style>
  .research-feed-card {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid #dfe2e5;
    border-radius: 6px;
    background: #fff;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .research-feed-card:hover {
    border-color: #c7cbcf;
    box-shadow: 0 14px 34px rgba(17, 24, 39, 0.09);
    transform: translateY(-3px);
  }

  .research-feed-card > a {
    display: flex;
    min-height: 440px;
    flex-direction: column;
    color: #151515;
  }

  .research-feed-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid #e5e7e9;
    background: #e9ecef;
  }

  .research-feed-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
  }

  .research-feed-card:hover .research-feed-media img {
    transform: scale(1.025);
  }

  .research-feed-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 22px 20px;
  }

  .research-feed-eyebrow {
    color: #c93430;
    font-size: 12px;
    font-weight: 760;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .research-feed-content > strong {
    display: -webkit-box;
    margin-top: 14px;
    overflow: hidden;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 21px;
    font-weight: 760;
    line-height: 1.3;
    letter-spacing: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .research-feed-description {
    display: -webkit-box;
    margin-top: 14px;
    overflow: hidden;
    color: #60656b;
    font-size: 14px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .research-feed-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-top: auto;
    padding-top: 22px;
    color: #777c82;
    font-size: 12px;
    line-height: 1.4;
  }

  .research-feed-footer > span {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .research-feed-footer time {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .research-feed-card,
    .research-feed-media img {
      transition: none;
    }
  }
</style>
