---
import GlobeMap from './GlobeMap.astro';
import StarsCanvas from './StarsCanvas.astro';
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero-earth">
    <GlobeMap />
  </div>
  <StarsCanvas mode="overlay" />

  <div class="home-hero-content" data-home-hero-content>
    <h1
      id="home-hero-title"
      data-en="Building machines that perceive and reason — at the crossroads of vision, language and remote sensing"
      data-zh="在视觉、语言与遥感的交叉地带，构建能感知、会思考的智能"
    >Building machines that perceive and reason — at the crossroads of vision, language and remote sensing</h1>
    <p
      class="home-hero-description"
      data-en="Led by Dr. Wenjia Xu, our group works at the intersection of computer vision, natural language processing and remote sensing, with a focus on multi-modal large language models, agents, and few-shot learning."
      data-zh="实验室由许文嘉老师带领，研究横跨计算机视觉、自然语言处理与遥感，聚焦多模态大模型、智能体与小样本学习。"
    >Led by Dr. Wenjia Xu, our group works at the intersection of computer vision, natural language processing and remote sensing, with a focus on multi-modal large language models, agents, and few-shot learning.</p>
    <div class="home-hero-actions">
      <a class="home-hero-button is-primary" href="/research/" data-en="Explore research" data-zh="探索研究">Explore research</a>
      <a class="home-hero-button" href="/join-us/" data-en="Join us" data-zh="加入我们">Join us</a>
    </div>
  </div>
</section>

<script>
  const homeHero = document.querySelector<HTMLElement>('.home-hero');
  const homeHeroContent = homeHero?.querySelector<HTMLElement>('[data-home-hero-content]');

  const setHeroContentHidden = (hidden: boolean) => {
    if (!homeHero || !homeHeroContent) return;
    homeHero.classList.toggle('is-content-hidden', hidden);
    homeHeroContent.setAttribute('aria-hidden', String(hidden));
  };

  homeHero?.addEventListener('dblclick', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-home-hero-content]')) return;
    event.preventDefault();
    event.stopPropagation();
    setHeroContentHidden(!homeHero.classList.contains('is-content-hidden'));
  }, { capture: true });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && homeHero?.classList.contains('is-content-hidden')) {
      setHeroContentHidden(false);
    }
  });
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 720px;
    max-height: none;
    overflow: hidden;
    background: #000;
  }

  .home-hero-earth {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero-earth :global(.globe-section) {
    width: 100%;
    height: 100%;
  }

  .home-hero-earth :global(.globe-scroll-hint) {
    display: none;
  }

  :global(.home-hero > .stars-canvas) {
    opacity: 0.72;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 48%, transparent 82%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 48%, transparent 82%);
  }

  .home-hero-content {
    position: absolute;
    z-index: 3;
    top: 20%;
    left: clamp(28px, 7.5%, 128px);
    display: flex;
    width: min(960px, calc(100% - 56px));
    padding: 34px 36px 36px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 18px;
    flex-direction: column;
    align-items: flex-start;
    color: #fff;
    background: rgba(255, 255, 255, 0.11);
    box-shadow: 0 20px 56px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(18px) saturate(1.15);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
    text-shadow: 0 3px 24px rgba(0, 0, 0, 0.65);
    transition: opacity 360ms ease, transform 360ms ease, visibility 360ms;
  }

  .home-hero.is-content-hidden .home-hero-content {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
  }

  .home-hero-content h1 {
    margin: 0;
    font-family: "Public Sans Variable", "Public Sans", Arial, sans-serif;
    font-size: 60px;
    font-weight: 780;
    line-height: 1.06;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .home-hero-description {
    max-width: 780px;
    margin: 24px 0 30px;
    color: rgba(255, 255, 255, 0.94);
    font-family: "Public Sans Variable", "Public Sans", Arial, sans-serif;
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .home-hero-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    border: 1px solid rgba(255, 255, 255, 0.64);
    border-radius: 8px;
    color: #fff;
    background: rgba(5, 5, 5, 0.42);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .home-hero-button.is-primary {
    border-color: #e53935;
    background: #e53935;
  }

  .home-hero-button:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-2px);
  }

  .home-hero-button.is-primary:hover {
    background: #c92f2b;
  }

  .home-hero-button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .home-hero-content h1 {
      font-size: 48px;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      height: 100svh;
      min-height: 760px;
    }

    .home-hero-content {
      top: 138px;
      right: 20px;
      left: 20px;
      width: auto;
      padding: 24px 22px 26px;
      border-radius: 14px;
      align-items: flex-start;
      text-align: left;
    }

    .home-hero-content h1 {
      font-size: 36px;
      line-height: 1.08;
    }

    .home-hero-description {
      margin: 18px 0 22px;
      font-size: 15px;
      line-height: 1.48;
    }

    .home-hero-button {
      min-height: 44px;
      padding-inline: 18px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-button {
      animation: none;
      transition: none;
    }
  }
</style>
