---
import { researchDirections } from '../data/research';
---

<section class="research-directions" id="research-directions" aria-labelledby="research-directions-title">
  <div class="research-directions-inner">
    <header class="research-directions-header">
      <h2
        id="research-directions-title"
        data-en="The scientific questions we address"
        data-zh="我们关注的科学问题"
      >The scientific questions we address</h2>
      <a class="research-directions-link" href="/research/">
        <span class="research-directions-link-label" data-en="View Research" data-zh="查看研究">View Research</span>
        <svg class="research-directions-link-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle class="button-primary-circle" cx="16" cy="16" r="16"></circle>
          <path d="M8 16.956h12.604l-3.844 4.106 1.252 1.338L24 16l-5.988-6.4-1.252 1.338 3.844 4.106H8v1.912z" class="color-spacesuit-white"></path>
        </svg>
      </a>
    </header>
    <p
      class="research-directions-intro"
      data-en="Our work spans vision, language and remote sensing, organized around perception, understanding and decision-making."
      data-zh="我们的研究横跨视觉、语言与遥感，并围绕感知、理解与决策展开。"
    >Our work spans vision, language and remote sensing, organized around perception, understanding and decision-making.</p>

    <div class="research-directions-grid">
      {researchDirections.map((direction) => (
        <article class="research-direction">
          <div class="research-direction-media">
            <img src={direction.image} alt={direction.alt} loading="lazy" decoding="async" />
            <div class="research-direction-content">
              <h3 data-en={direction.title} data-zh={direction.titleZh}>{direction.title}</h3>
              <p
                class="research-direction-description"
                data-en={direction.description}
                data-zh={direction.descriptionZh}
              >{direction.description}</p>
              <a class="research-direction-learn-more" href={`/research/?direction=${direction.id}`}>
                <span data-en="Learn more" data-zh="了解更多">Learn more</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 8h9M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .research-directions {
    position: relative;
    z-index: 2;
    padding: var(--home-section-gap) 0 0;
    color: #111;
    background: #fff;
  }

  .research-directions-inner {
    width: min(calc(100% - 96px), 1260px);
    margin-inline: auto;
  }

  .research-directions-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 64px;
  }

  .research-directions-header h2 {
    max-width: 960px;
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .research-directions-link {
    position: relative;
    z-index: 1;
    display: inline-grid;
    grid-template-columns: max-content 28px;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    color: #111;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 17px;
    font-weight: 760;
    white-space: nowrap;
  }

  .research-directions-link-label {
    position: relative;
    z-index: 1;
  }

  .research-directions-link-icon {
    position: relative;
    z-index: 2;
    display: block;
    width: 28px;
    height: 28px;
    overflow: visible;
    transition: transform 180ms ease;
  }

  .research-directions-link-icon .button-primary-circle {
    fill: #e53935;
  }

  .research-directions-link-icon .color-spacesuit-white {
    fill: #fff;
  }

  .research-directions-link:hover .research-directions-link-icon {
    transform: translateX(3px);
  }

  .research-directions-intro {
    max-width: 620px;
    margin: 24px 0 0;
    color: #555;
    font-size: 18px;
    line-height: 1.55;
  }

  .research-directions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
    margin-top: 56px;
  }

  .research-direction {
    min-width: 0;
  }

  .research-direction-media {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: #dfe3e6;
    aspect-ratio: 2 / 1;
  }

  .research-direction-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .research-direction:hover .research-direction-media img {
    transform: scale(1.025);
  }

  .research-direction-content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    padding: 24px 26px 26px;
  }

  .research-direction h3 {
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 24px;
    font-weight: 760;
    line-height: 1.22;
    letter-spacing: 0;
    color: #fff;
  }

  .research-direction-description {
    max-width: 100%;
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 16px;
    line-height: 1.55;
  }

  .research-direction-learn-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    color: #fff;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
    transition: gap 180ms ease, opacity 180ms ease;
    opacity: 0.85;
  }

  .research-direction-learn-more:hover {
    gap: 10px;
    opacity: 1;
  }

  .research-direction-learn-more svg {
    flex: 0 0 auto;
    transition: transform 180ms ease;
  }

  .research-direction-learn-more:hover svg {
    transform: translateX(2px);
  }

  @media (max-width: 1020px) {
    .research-directions-inner {
      width: min(calc(100% - 48px), 900px);
    }

    .research-directions-header {
      gap: 32px;
    }

    .research-directions-header h2 {
      font-size: 44px;
    }

    .research-directions-grid {
      gap: 32px 20px;
    }

    .research-direction h3 {
      font-size: 22px;
    }

    .research-direction-description {
      font-size: 15px;
    }
  }

  @media (max-width: 600px) {
    .research-directions {
      padding: var(--home-section-gap) 0 0;
    }

    .research-directions-inner {
      width: calc(100% - 40px);
    }

    .research-directions-header h2 {
      font-size: 36px;
      line-height: 1.04;
    }

    .research-directions-header {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .research-directions-link {
      margin-top: 0;
      font-size: 16px;
    }

    .research-directions-intro {
      margin-top: 28px;
      font-size: 16px;
    }

    .research-directions-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      margin-top: 48px;
    }

    .research-direction-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
