---
const { deferred = false } = Astro.props;
---
<section class="globe-section" data-galaxy>
  <div id="globe-container" data-deferred={deferred ? 'true' : 'false'}></div>
  <div class="globe-overlay"></div>
  <div class="globe-search-bar" id="globe-search-bar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
    </svg>
    <span class="globe-search-bar-text" data-en="Search place or coordinates" data-zh="搜索地点或坐标">Search place or coordinates</span>
  </div>
  <div class="globe-search-overlay" id="globe-search-overlay" hidden>
    <div class="globe-search-panel">
      <div class="globe-search-input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" id="globe-search-input"
          placeholder="Search place or coordinates..."
          data-i18n-placeholder-en="Search place or coordinates..."
          data-i18n-placeholder-zh="搜索地点或坐标..."
          autocomplete="off" />
        <button class="globe-search-close" id="globe-search-close">&times;</button>
      </div>
      <div class="globe-search-options">
        <div class="globe-search-hint" data-en="latitude, longitude (e.g. 37.87, -117.54)" data-zh="纬度, 经度 (如 37.87, -117.54)" data-resolved-en="✓ Location resolved — select zoom, press Enter to go" data-resolved-zh="✓ 已定位 — 选择缩放级别后按回车跳转">latitude, longitude (e.g. 37.87, -117.54)</div>
        <div class="globe-zoom-legends" id="globe-zoom-legends">
          <button data-zoom="10" data-en="10km" data-zh="10公里">10km</button>
          <button data-zoom="12" data-en="5km" data-zh="5公里">5km</button>
          <button data-zoom="13" data-en="1km" data-zh="1公里">1km</button>
          <button data-zoom="16" data-en="100m" data-zh="100米">100m</button>
          <button data-zoom="19" data-en="10m" data-zh="10米">10m</button>
        </div>
      </div>
    </div>
  </div>
  <button class="globe-reset-view" id="globe-reset-view" type="button" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
    </svg>
    <span data-en="Back to globe" data-zh="返回地球">Back to globe</span>
  </button>
  <div class="globe-scroll-hint" data-galaxy-hint onclick="window.scrollTo({top: window.innerHeight, behavior: 'smooth'})">
    <span data-en="Scroll to explore" data-zh="滚动探索">Scroll to explore</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </div>
</section>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.16.0/mapbox-gl.css" rel="stylesheet" />
<script>
  import mapboxgl from 'mapbox-gl';

  const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;
  mapboxgl.accessToken = MAPBOX_TOKEN;

  const container = document.getElementById('globe-container');

  let mapRef: any = null;

  const initGlobe = () => {
    if (!container || mapRef) {
      mapRef?.resize();
      return;
    }

    // The globe should always render at the same on-screen size, so the resting
    // zoom is derived from the viewport rather than hard-coded. In the globe
    // projection the sphere's diameter in pixels is (512 * 2^zoom) / PI.
    const restingZoom = () => {
      const target = Math.min(window.innerWidth, window.innerHeight) * 0.82;
      const zoom = Math.log2((target * Math.PI) / 512);
      return Math.min(Math.max(zoom, 1.4), 3);
    };

    const map = new mapboxgl.Map({
      container,
      style: 'mapbox://styles/onethree/cmhlxuxs1002n01pj28o0hhx6',
      zoom: restingZoom(),
      center: [104, 35],
      attributionControl: false,
      // Keep the globe at a fixed size: drag still spins it, but no gesture
      // resizes it, and the wheel scrolls the page instead of zooming the map.
      scrollZoom: false,
      boxZoom: false,
      doubleClickZoom: false,
      touchZoomRotate: false,
      touchPitch: false,
      dragRotate: false,
      keyboard: false,
    });
    mapRef = map;

    let userInteracting = false;
    const secondsPerRevolution = 180;
    const maxSpinZoom = 5;
    const slowSpinZoom = 3;

    // Place search still flies in programmatically; this button is the
    // way back now that the wheel no longer zooms out.
    const resetViewButton = document.getElementById('globe-reset-view');
    const syncResetView = () => {
      if (resetViewButton) resetViewButton.hidden = map.getZoom() <= restingZoom() + 0.5;
    };

    resetViewButton?.addEventListener('click', () => {
      userInteracting = true;
      map.easeTo({ zoom: restingZoom(), pitch: 0, bearing: 0, duration: 1200 });
      map.once('moveend', () => { userInteracting = false; spinGlobe(); });
    });

    window.addEventListener('resize', () => {
      map.resize();
      // Only re-fit while we are still looking at the whole globe, so a resize
      // never yanks the camera back out of a location the user flew to.
      if (map.getZoom() <= maxSpinZoom) map.setZoom(restingZoom());
    });

    function spinGlobe() {
      const zoom = map.getZoom();
      if (!userInteracting && zoom < maxSpinZoom) {
        let distancePerSecond = 360 / secondsPerRevolution;
        if (zoom > slowSpinZoom) {
          distancePerSecond *= (maxSpinZoom - zoom) / (maxSpinZoom - slowSpinZoom);
        }
        const center = map.getCenter();
        center.lng -= distancePerSecond;
        map.easeTo({ center, duration: 1000, easing: (n) => n });
      }
    }

    map.on('mousedown', () => { userInteracting = true; });
    map.on('mouseup', () => { userInteracting = false; spinGlobe(); });
    map.on('dragend', () => { userInteracting = false; spinGlobe(); });
    map.on('pitchend', () => { userInteracting = false; spinGlobe(); });
    map.on('rotateend', () => { userInteracting = false; spinGlobe(); });
    map.on('moveend', spinGlobe);
    map.on('zoomend', syncResetView);
    map.on('moveend', syncResetView);

    spinGlobe();

    // Globe search overlay
    const globeSearchOverlay = document.getElementById('globe-search-overlay');
    const globeSearchInput = document.getElementById('globe-search-input') as HTMLInputElement;
    const globeSearchHint = document.querySelector('.globe-search-hint');

    let selectedZoom = 10;
    let resolvedCenter: [number, number] | null = null;

    // Open overlay
    document.getElementById('globe-search-bar')?.addEventListener('click', () => {
      if (globeSearchOverlay) globeSearchOverlay.hidden = false;
      if (globeSearchInput) {
        globeSearchInput.value = '';
        resolvedCenter = null;
        setTimeout(() => globeSearchInput.focus(), 50);
      }
    });

    // Close overlay
    document.getElementById('globe-search-close')?.addEventListener('click', () => {
      if (globeSearchOverlay) globeSearchOverlay.hidden = true;
    });
    globeSearchOverlay?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) globeSearchOverlay.hidden = true;
    });

    // Search on Enter — step 1: resolve location; step 2: fly
    globeSearchInput?.addEventListener('keydown', async (e) => {
      if (e.key !== 'Enter') return;
      const q = globeSearchInput.value.trim();
      if (!q) return;

      // If we already resolved a center, fly there
      if (resolvedCenter) {
        globeSearchOverlay!.hidden = true;
        userInteracting = true;
        map.flyTo({ center: resolvedCenter, zoom: selectedZoom, duration: 2000 });
        setTimeout(() => { userInteracting = false; }, 2100);
        resolvedCenter = null;
        return;
      }

      const lang = document.documentElement.lang === 'zh-CN' ? 'zh' : 'en';

      // Try parsing as coordinates (lat, lng)
      const coordMatch = q.match(/^(-?\d+\.?\d*)\s*[,\s]\s*(-?\d+\.?\d*)$/);
      if (coordMatch) {
        const lat = parseFloat(coordMatch[1]);
        const lng = parseFloat(coordMatch[2]);
        if (Math.abs(lat) <= 90 && Math.abs(lng) <= 180) {
          resolvedCenter = [lng, lat];
          if (globeSearchHint) {
            const label = globeSearchHint.getAttribute(`data-resolved-${lang}`) || '✓ Location resolved — select zoom, press Enter to go';
            globeSearchHint.textContent = label;
            globeSearchHint.classList.add('resolved');
          }
          return;
        }
      }

      // Geocode via Mapbox
      try {
        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(q)}.json?access_token=${MAPBOX_TOKEN}&limit=1`;
        const res = await fetch(url);
        const data = await res.json();
        if (data.features?.length > 0) {
          const [lng, lat] = data.features[0].center;
          resolvedCenter = [lng, lat];
          if (globeSearchHint) {
            const name = data.features[0].place_name || q;
            globeSearchHint.textContent = `✓ ${name}`;
            globeSearchHint.classList.add('resolved');
          }
        } else {
          if (globeSearchHint) {
            const noResult = lang === 'zh' ? '未找到结果' : 'No results found';
            globeSearchHint.textContent = noResult;
            globeSearchHint.classList.remove('resolved');
          }
        }
      } catch (err) {
        console.error('Geocoding failed:', err);
      }
    });

    // Reset hint when input changes
    globeSearchInput?.addEventListener('input', () => {
      resolvedCenter = null;
      if (globeSearchHint) {
        const defaultText = globeSearchHint.getAttribute(
          `data-${document.documentElement.lang === 'zh-CN' ? 'zh' : 'en'}`
        ) || globeSearchHint.getAttribute('data-en') || '';
        globeSearchHint.textContent = defaultText;
        globeSearchHint.classList.remove('resolved');
      }
    });

    // Zoom legend buttons — just select, don't fly
    const zoomLegends = document.getElementById('globe-zoom-legends');
    zoomLegends?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button') as HTMLButtonElement;
      if (!btn) return;
      selectedZoom = parseInt(btn.dataset.zoom || '10');
      zoomLegends.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  };

  if (container?.dataset.deferred === 'true') {
    window.addEventListener('earth-explorer:open', initGlobe);
  } else {
    initGlobe();
  }

  // Fade out scroll hint on scroll
  const hint = document.querySelector<HTMLElement>('[data-galaxy-hint]');
  window.addEventListener('scroll', () => {
    if (hint) hint.style.opacity = String(Math.max(0, 1 - window.scrollY / 200));
  }, { passive: true });
</script>

<style>
  .globe-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #050510;
    z-index: 1;
  }

  #globe-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
  }

  :global(#globe-container .mapboxgl-canvas-container),
  :global(#globe-container .mapboxgl-canvas) {
    width: 100% !important;
    height: 100% !important;
  }

  .globe-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    z-index: 2;
    pointer-events: none;
  }

  .globe-scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 2;
    cursor: pointer;
    animation: fadeInUp 1.2s ease-out 0.6s both, float 3s ease-in-out infinite 1.8s;
  }

  .globe-scroll-hint:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes float {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }


  /* Globe search trigger bar */
  .globe-reset-view {
    position: absolute;
    bottom: 20px;
    right: 200px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 45px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    color: rgba(255, 255, 255, 0.86);
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
    font: inherit;
    font-size: 13px;
    z-index: 12;
    cursor: pointer;
    transition: all 0.3s;
  }

  .globe-reset-view[hidden] {
    display: none;
  }

  .globe-reset-view:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
  }

  .globe-reset-view svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  .globe-search-bar {
    position: absolute;
    bottom: 20px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    height:45px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
    z-index: 12;
    cursor: pointer;
    transition: all 0.3s;
  }

  .globe-search-bar:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .globe-search-bar svg {
    width: 14px;
    height: 14px;
    color: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .globe-search-bar-text {
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Globe search overlay */
  .globe-search-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    animation: fadeIn 0.2s ease-out;
  }

  .globe-search-overlay[hidden] {
    display: none !important;
  }

  .globe-search-panel {
    width: min(640px, 90vw);
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
    overflow: hidden;
    animation: popIn 0.25s ease-out;
  }

  .globe-search-input-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
  }

  .globe-search-input-wrap svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.4);
    fill: none;
    stroke: currentColor;
    stroke-width: 2.3;
  }

  .globe-search-input-wrap input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font-size: clamp(16px, 1.2vw, 20px);
    letter-spacing: -0.03em;
  }

  .globe-search-input-wrap input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .globe-search-close {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .globe-search-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .globe-search-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 22px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .globe-search-hint {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    white-space: nowrap;
    transition: color 0.2s;
  }

  .globe-search-hint.resolved {
    color: rgba(100, 220, 150, 0.8);
  }

  .globe-zoom-legends {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .globe-zoom-legends button {
    padding: 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .globe-zoom-legends button:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .globe-zoom-legends button.active {
    color: #000;
    background: #fff;
    border-color: transparent;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 640px) {
    .globe-search-bar {
      bottom: 70px;
      right: 12px;
    }
    .globe-reset-view {
      bottom: 124px;
      right: 12px;
    }
    .globe-search-options {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .globe-zoom-legends {
      flex-wrap: wrap;
    }
  }
</style>
