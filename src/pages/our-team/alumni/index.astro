---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { alumni } from '../../../data/alumni';

const alumniEntries = alumni.map((member) => ({
  ...member,
  summaryEn: [
    member.formerRole,
    member.year ? `Class of ${member.year}` : '',
    member.destination ? `Now at ${member.destination}` : '',
  ].filter(Boolean).join(' · '),
  summaryZh: [
    member.formerRoleZh,
    member.year ? `${member.year} 届` : '',
    member.destinationZh ? `去向：${member.destinationZh}` : member.destination ? `去向：${member.destination}` : '',
  ].filter(Boolean).join(' · '),
}));
---

<BaseLayout
  title="Alumni | IntelliSense Lab"
  description="Former students and researchers of IntelliSense Lab."
  headerMode="glass"
  bodyClass="archive-light-theme"
>
  <main class="alumni-page">
    <div class="container alumni-page-inner">
      <a class="alumni-back" href="/our-team/" data-en="← Back to Our Team" data-zh="← 返回团队">← Back to Our Team</a>

      <header class="alumni-header">
        <h1 data-en="Alumni" data-zh="校友">Alumni</h1>
        <p
          data-en="Former students and researchers who have contributed to IntelliSense Lab."
          data-zh="曾在 IntelliSense Lab 学习和工作过的成员。"
        >Former students and researchers who have contributed to IntelliSense Lab.</p>
      </header>

      <div class="alumni-layout">
        <aside class="alumni-index" aria-label="Alumni directory">
          <div class="alumni-index-image">
            <img src="/assets/team/alumni.jpg" alt="Earth seen from orbit" loading="eager" decoding="async" />
          </div>
          <strong data-en="Alumni directory" data-zh="校友名录">Alumni directory</strong>
          <span>{String(alumniEntries.length).padStart(2, '0')}</span>
        </aside>

        <section class="alumni-directory" aria-labelledby="alumni-list-title">
          <h2 id="alumni-list-title" data-en="A list of alumni" data-zh="校友名单">A list of alumni</h2>

          {alumniEntries.length > 0 ? (
            <ul class="alumni-list">
              {alumniEntries.map((member) => (
                <li>
                  <article class="alumni-entry">
                    <div>
                      {member.homepage ? (
                        <a href={member.homepage} target="_blank" rel="noreferrer">
                          <strong data-en={member.name} data-zh={member.nameZh ?? member.name}>{member.name}</strong>
                        </a>
                      ) : (
                        <strong data-en={member.name} data-zh={member.nameZh ?? member.name}>{member.name}</strong>
                      )}
                      <p data-en={member.summaryEn} data-zh={member.summaryZh}>{member.summaryEn}</p>
                    </div>
                    {member.homepage && <span aria-hidden="true">↗</span>}
                  </article>
                </li>
              ))}
            </ul>
          ) : (
            <p
              class="alumni-empty"
              data-en="Alumni records will be listed here as the directory is completed."
              data-zh="校友资料整理好后会在这里展示。"
            >Alumni records will be listed here as the directory is completed.</p>
          )}
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .alumni-page {
    min-height: 82vh;
    padding: 126px 0 128px;
    color: #111;
    background: #fff;
  }

  .alumni-page-inner {
    width: min(calc(100% - 96px), 1260px);
  }

  .alumni-back {
    display: inline-block;
    margin-bottom: 50px;
    color: #686e74;
    font-size: 14px;
  }

  .alumni-back:hover {
    color: #c93430;
  }

  .alumni-header {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(360px, 1fr);
    align-items: end;
    gap: 72px;
    padding-bottom: 54px;
    border-bottom: 1px solid #dfe2e5;
  }

  .alumni-header h1 {
    margin: 0;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
  }

  .alumni-header p {
    max-width: 680px;
    margin: 0;
    color: #5f656b;
    font-size: 17px;
    line-height: 1.65;
  }

  .alumni-layout {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: 88px;
    padding-top: 72px;
  }

  .alumni-index {
    align-self: start;
  }

  .alumni-index-image {
    aspect-ratio: 1;
    overflow: hidden;
    border: 8px solid #fff;
    border-radius: 12px;
    background: #f1f3f4;
    box-shadow: 0 0 0 1px #d9dcdf, 0 12px 30px rgba(17, 24, 39, 0.12);
  }

  .alumni-index-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.22);
  }

  .alumni-index strong {
    display: block;
    margin-top: 22px;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 20px;
    font-weight: 750;
  }

  .alumni-index > span {
    display: block;
    margin-top: 8px;
    color: #c93430;
    font-size: 13px;
    font-weight: 800;
  }

  .alumni-directory h2 {
    margin: 0 0 34px;
    font-family: "Inter Variable", Inter, Arial, sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .alumni-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid #dfe2e5;
    list-style: none;
  }

  .alumni-list li {
    border-bottom: 1px solid #dfe2e5;
  }

  .alumni-entry {
    display: flex;
    min-height: 104px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 22px 4px;
  }

  .alumni-entry strong {
    font-size: 19px;
    font-weight: 750;
  }

  .alumni-entry a:hover strong {
    color: #c93430;
  }

  .alumni-entry p {
    margin: 7px 0 0;
    color: #666c72;
    font-size: 14px;
    line-height: 1.55;
  }

  .alumni-entry > span {
    color: #c93430;
    font-size: 20px;
  }

  .alumni-empty {
    margin: 0;
    padding: 30px 0;
    border-top: 1px solid #dfe2e5;
    border-bottom: 1px solid #dfe2e5;
    color: #747a80;
    font-size: 15px;
  }

  @media (max-width: 800px) {
    .alumni-page {
      padding: 126px 0 88px;
    }

    .alumni-page-inner {
      width: calc(100% - 40px);
    }

    .alumni-header,
    .alumni-layout {
      grid-template-columns: 1fr;
    }

    .alumni-header {
      gap: 22px;
      padding-bottom: 38px;
    }

    .alumni-header h1 {
      font-size: 46px;
    }

    .alumni-layout {
      gap: 48px;
      padding-top: 48px;
    }

    .alumni-index {
      width: min(250px, 72vw);
    }

    .alumni-directory h2 {
      font-size: 31px;
    }
  }
</style>
